[Unit]
Description=Node Activity Alerts - DMR Watcher
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=admin
WorkingDirectory=/home/admin
ExecStart=/home/admin/hamalerts-venv/bin/python /home/admin/dmr_watcher.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
